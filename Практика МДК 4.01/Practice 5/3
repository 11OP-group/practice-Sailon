# ввод чисел
x = int(input())

#разбираем
tis = x // 1000 # поделили на 1000 без остатка и всё
sto = x // 100 % 10 # поделили на 100, чтобы остались 2 цифры, а потом нашли остаток от деления на 10
des = x // 10 % 10 # поделили на 10, чтобы отбросить единицы, а потом нашли остаток от деления на 10
edin = x % 10 # поделили на 10

# вывод
print("Тысячи: ", tis)
print("Сотни: ", sto)
print("Десятки: ", des)
print("Единицы: ", edin)
